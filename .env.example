# Администратор общего сервера PostgreSQL.
# Используется для первоначальной настройки и входа через Adminer.
POSTGRES_ADMIN_USER=postgres
POSTGRES_DEFAULT_DB=postgres
POSTGRES_ADMIN_PASSWORD=local_admin_password

# Подключение приложения Workspaces.
WORKSPACES_DB_NAME=workspaces_db
WORKSPACES_DB_USER=workspaces_user
WORKSPACES_DB_PASSWORD=local_workspaces_password

# Подключение приложения Events.
EVENTS_DB_NAME=events_db
EVENTS_DB_USER=events_user
EVENTS_DB_PASSWORD=local_events_password